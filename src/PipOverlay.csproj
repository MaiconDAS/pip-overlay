<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PipOverlay</AssemblyName>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
    <Version>0.10.0</Version>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ProductionBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);PRODUCTION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ProductionBuild)' == 'true'">
    <Compile Remove="GeometryTests.cs;AutoConnectTests.cs;HotkeyTests.cs;DemoSource.cs;GpuValidation.cs;ValidationV4.cs;Diagnostics.cs;SelfTest.cs;RtssTest.cs;Overlay.cs;VideoSession.cs;LegacyRtssFrameOutput.cs;RtssFrameOutput.cs;RtssClient.cs" />
  </ItemGroup>
</Project>
